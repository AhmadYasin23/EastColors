# Public build-time configuration (safe to expose in browser bundles)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Server-only secrets: keep these out of Git and set them with Cloudflare secrets.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
MAILJET_API_KEY=replace_me
MAILJET_SECRET_KEY=replace_me
MAILJET_FROM_EMAIL=noreply@alwanalsharq.com
MAILJET_TO_EMAIL=recipient@example.com
MAILJET_TO_NAME=East Colors Team
TURNSTILE_SECRET_KEY=replace_me
TURNSTILE_ALLOWED_HOSTNAMES=alwanalsharq.com,www.alwanalsharq.com
